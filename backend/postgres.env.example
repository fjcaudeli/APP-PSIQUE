# Variables PostgreSQL; completar únicamente fuera del repositorio.
# Completar con las credenciales de la etapa 1. Nunca usar el superusuario postgres.
MIGRATION_DATABASE_URL=
APP_DATABASE_URL=
# Conexión obligatoria del servidor habitual: psique_app/psique.
DATABASE_URL=
# Desarrollo local; producción exige verify-full y NODE_ENV=production.
NODE_ENV=development
DATABASE_SSL_MODE=disable
# Solo si el proveedor requiere una CA propia: ruta privada al certificado público.
# DATABASE_SSL_CA_FILE=
