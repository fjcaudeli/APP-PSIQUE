# Referencia para variables privadas del hosting futuro. No contiene valores reales.
NODE_ENV=production
HOST=0.0.0.0
# Render suministra PORT al Web Service; no se fija en el código.
# PORT=
FRONTEND_ORIGIN=
DATABASE_URL=
JWT_SECRET=
DATABASE_SSL_MODE=verify-full
# Opcional: certificado CA público, por archivo privado de configuración del hosting.
# DATABASE_SSL_CA_FILE=
# Completar solo después de verificar la cadena de proxies de la instancia real.
# Vacío no confía en X-Forwarded-For; clientes del proxy compartirían el cupo.
TRUSTED_PROXY_CIDRS=
# Solo al habilitar el cliente Android remoto; conserva el origen web anterior.
# CAPACITOR_ANDROID_ORIGIN=https://localhost
# Sin correo configurado, las altas nuevas y solicitudes de correo responden 503.
# Completar privadamente: CORREO_PROVEEDOR=resend y un remitente autorizado.
CORREO_PROVEEDOR=
CORREO_REMITENTE=
RESEND_API_KEY=
# Sin dominio verificado, limitar al email de la propia cuenta de Resend.
# No redirige correos de terceros ni elimina la confirmación obligatoria.
CORREO_DESTINATARIO_PRUEBA=
