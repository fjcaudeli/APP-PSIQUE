# Copiar a .env si no existe y completar JWT_SECRET antes de iniciar la API.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
FRONTEND_ORIGIN=http://127.0.0.1:4200
DATABASE_SSL_MODE=disable
# Vacío significa no confiar en encabezados de proxies.
TRUSTED_PROXY_CIDRS=
# Base activa: psique con el rol psique_app. También puede suministrarse mediante
# el lanzador privado; no copiar credenciales reales a este archivo de ejemplo.
DATABASE_URL=
# Generar un secreto aleatorio propio de al menos 32 bytes; ver README.
# No compartir el .env ni subirlo al repositorio. Aquí no hay una clave real.
JWT_SECRET=
# Opcional hasta configurar el envío real. Sin proveedor no se habilitan nuevas
# altas ni solicitudes de correo; nunca se simulan envíos exitosos.
# Proveedor soportado: resend, mediante su API HTTPS.
CORREO_PROVEEDOR=
CORREO_REMITENTE=
RESEND_API_KEY=
# Durante las pruebas sin dominio, limitar al email de la cuenta de Resend.
# Vacío permite los destinatarios que autorice el proveedor con dominio verificado.
CORREO_DESTINATARIO_PRUEBA=
