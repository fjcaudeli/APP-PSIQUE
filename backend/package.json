{
  "name": "psique-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API local de consulta de PSIQUE con Express y SQLite.",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "engines": {
    "node": "^24.14.1"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3"
  }
}
