{
  "name": "psique-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API local de PSIQUE con Express y PostgreSQL.",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "db:migrate": "node scripts/migrar.mjs",
    "db:status": "node scripts/migrar.mjs --status",
    "db:migrate:test": "node scripts/migrar.mjs --test",
    "db:status:test": "node scripts/migrar.mjs --test --status",
    "db:verify": "node scripts/verificar-postgres.mjs",
    "test:postgres": "npm run build && node --test --test-concurrency=1 test-postgres/*.test.mjs",
    "test:postgres:auth": "npm run build && node --test test-postgres/auth.test.mjs",
    "test:postgres:api": "npm run build && node --test test-postgres/api.test.mjs",
    "test:postgres:server": "npm run build && node --test test-postgres/servidor.test.mjs",
    "db:connect": "node scripts/comprobar-pool.mjs"
  },
  "engines": {
    "node": "^24.14.1"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "typescript": "~5.9.3"
  }
}
